# Copy this to .env and fill in values

# PostgreSQL
# Local Docker (default for dev — works with docker-compose):
DATABASE_URL=postgresql+asyncpg://perfinuser:perfinpass@localhost:5432/perfindb

# Neon (free production) — drop channel_binding, keep sslmode=require:
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>.neon.tech/<db>?sslmode=require

# Claude API
ANTHROPIC_API_KEY=sk-ant-api03-...

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
